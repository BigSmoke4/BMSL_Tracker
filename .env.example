# Copy to .env and adjust — used by docker compose (never commit real secrets).
# .env is git-ignored via the *.env pattern conventions below (see .gitignore comments).

# SQL Server "sa" password (compose generates the database and app connection string from it)
MSSQL_SA_PASSWORD=ChangeMe_Strong_Pw1!

# Optional: Google sign-in (see docs/GOOGLE-AUTH.md)
#Authentication__Google__ClientId=1234567890-abcdef.apps.googleusercontent.com
#Authentication__Google__ClientSecret=GOCSPX-xxxxxxxx

# Optional: SignalR Redis backplane for multi-instance scale-out
#ConnectionStrings__Redis=redis:6379

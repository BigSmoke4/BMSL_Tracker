{
  // Local development profile:
  //  - SQLite file database (auto-created next to the app via EnsureCreated, no migration step)
  //  - Google sign-in reads ClientId/ClientSecret from user-secrets or environment variables
  //    dotnet user-secrets set "Authentication:Google:ClientId" "xxxx.apps.googleusercontent.com"
  //    dotnet user-secrets set "Authentication:Google:ClientSecret" "GOCSPX-xxxx"
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrations": true
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    }
  },
  "Tracker": {
    // Keep full history during development for easier debugging of the map trails.
    "RetentionDays": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}

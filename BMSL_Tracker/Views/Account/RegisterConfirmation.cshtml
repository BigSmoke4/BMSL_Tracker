@{
    ViewData["Title"] = "Check your email";
}

<main class="auth-shell">
    <section class="auth-card text-center">
        <span class="brand-mark mx-auto mb-4" aria-hidden="true">✓</span>
        <p class="eyebrow">ONE LAST STEP</p>
        <h1 class="h2">Check your inbox</h1>
        <p class="auth-subtitle">If the address can receive mail, we’ve sent a confirmation link. Confirm your email before signing in.</p>
        <a class="btn btn-primary auth-submit mt-4" asp-action="Login">Back to sign in</a>
    </section>
</main>

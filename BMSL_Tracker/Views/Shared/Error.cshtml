@model ErrorViewModel
@{
    ViewData["Title"] = Model.HtmlTitle;
    var severityClass = Model.StatusCode >= 500 ? "danger" : "secondary";
}

<div class="row justify-content-center mt-5">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow">
            <div class="card-body p-4 text-center">
                <h1 class="display-5 mb-2 text-@severityClass">@Model.StatusCode</h1>
                <h2 class="h4 mb-3">@Model.Title</h2>
                <p class="text-muted mb-4">
                    @if (Model.StatusCode >= 500)
                    {
                        <span>Our team has been notified. Please try again in a moment.</span>
                    }
                    else
                    {
                        <span>The page you requested could not be completed as asked.</span>
                    }
                </p>
                <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to the live map</a>
            </div>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="text-center text-muted small mt-3">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }
    </div>
</div>

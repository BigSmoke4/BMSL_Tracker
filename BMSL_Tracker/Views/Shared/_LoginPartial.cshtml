@using Microsoft.AspNetCore.Identity
@using BMSL_Tracker.Services
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    var displayName = User.FindFirst(ExternalUserNames.DisplayNameClaimType)?.Value
                      ?? User.Identity?.Name
                      ?? "user";
}

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="navbar-text me-2" title="@displayName">
                Hello <strong class="fw-semibold">@displayName</strong>!
            </span>
        </li>
        <li class="nav-item">
            <form class="d-flex" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Sign up</a>
        </li>
        <li class="nav-item">
            <a class="nav-link btn btn-primary btn-sm align-self-center px-3" asp-controller="Account" asp-action="Login">
                Log in
            </a>
        </li>
    }
</ul>

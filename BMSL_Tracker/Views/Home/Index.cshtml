@{
    ViewData["Title"] = "Live team tracker";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" referrerpolicy="no-referrer" />

<section class="tracker-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-3">
        <div>
            <p class="eyebrow mb-2">BMSL TRACKER</p>
            <h1 class="h2 mb-1">Live team map</h1>
            <p class="text-muted mb-0">Start sharing only when you are ready. Signed-in teammates can see active locations.</p>
        </div>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span id="status" class="badge text-bg-secondary" role="status" aria-live="polite">Connecting…</span>
            <button id="shareLocation" type="button" class="btn btn-primary" disabled>Share my location</button>
            <button id="centerOnMe" type="button" class="btn btn-outline-secondary">Center on me</button>
        </div>
    </div>
    <div id="map" role="application" aria-label="Map showing active team locations"></div>
    <p class="small text-muted mt-3 mb-0">Location sharing uses your browser’s location permission and stops when you stop sharing or leave this page. <a asp-controller="Home" asp-action="Privacy">Read the location privacy notice.</a></p>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.12/dist/browser/signalr.min.js" referrerpolicy="no-referrer"></script>

    <script>
        (() => {
            const statusElement = document.getElementById("status");
            const shareButton = document.getElementById("shareLocation");
            const centerButton = document.getElementById("centerOnMe");
            const markers = new Map();
            const trailLines = new Map();
            const lastSeenByUser = new Map();
            const updateIntervalMilliseconds = 5000;
            const staleLocationMilliseconds = 30000;
            let myUserId = null;
            let geolocationWatchId = null;
            let lastUpdateTime = 0;
            let firstLocationSent = false;

            const map = L.map("map", { scrollWheelZoom: true }).setView([0, 0], 2);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution: "&copy; OpenStreetMap contributors"
            }).addTo(map);

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/trackerHub")
                .withAutomaticReconnect()
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            function setStatus(text, style = "secondary") {
                statusElement.textContent = text;
                statusElement.className = `badge text-bg-${style}`;
            }

            function removeUser(userId) {
                const key = String(userId);
                const marker = markers.get(key);
                const trail = trailLines.get(key);
                if (marker) {
                    map.removeLayer(marker);
                    markers.delete(key);
                }
                if (trail) {
                    map.removeLayer(trail);
                    trailLines.delete(key);
                }
                lastSeenByUser.delete(key);
                if (key === String(myUserId)) {
                    firstLocationSent = false;
                }
            }

            function createPopup(userName, accuracy, timestamp) {
                const content = document.createElement("div");
                const name = document.createElement("strong");
                name.textContent = userName || "Team member";
                content.appendChild(name);

                const accuracyValue = Number(accuracy);
                const accuracyText = document.createElement("div");
                accuracyText.textContent = Number.isFinite(accuracyValue)
                    ? `Accuracy: ${accuracyValue.toFixed(1)} m`
                    : "Accuracy unavailable";
                content.appendChild(accuracyText);

                const lastSeen = document.createElement("div");
                const parsedTimestamp = new Date(timestamp);
                lastSeen.textContent = `Last seen: ${Number.isNaN(parsedTimestamp.getTime()) ? "unknown" : parsedTimestamp.toLocaleTimeString()}`;
                content.appendChild(lastSeen);
                return content;
            }

            connection.on("YourId", userId => {
                myUserId = userId;
            });

            connection.on("ReceiveLocation", (userId, userName, latitude, longitude, accuracy, timestamp) => {
                if (!Number.isFinite(latitude) || !Number.isFinite(longitude)
                    || latitude < -90 || latitude > 90 || longitude < -180 || longitude > 180) {
                    return;
                }

                const key = String(userId);
                const point = [latitude, longitude];
                const popup = createPopup(userName, accuracy, timestamp);
                const parsedTimestamp = new Date(timestamp).getTime();
                lastSeenByUser.set(key, Number.isFinite(parsedTimestamp) ? parsedTimestamp : Date.now());

                if (markers.has(key)) {
                    markers.get(key).setLatLng(point).setPopupContent(popup);
                } else {
                    markers.set(key, L.marker(point).addTo(map).bindPopup(popup));
                    trailLines.set(key, L.polyline([], {
                        color: key === String(myUserId) ? "#3156d3" : "#7d8ba2",
                        weight: 3,
                        opacity: 0.65
                    }).addTo(map));
                }

                const trail = trailLines.get(key);
                trail.addLatLng(point);
                const trailPoints = trail.getLatLngs();
                if (trailPoints.length > 30) {
                    trail.setLatLngs(trailPoints.slice(-30));
                }

                if (key === String(myUserId) && !firstLocationSent) {
                    map.setView(point, 15);
                    firstLocationSent = true;
                }
            });

            connection.on("LocationStopped", userId => removeUser(userId));

            window.setInterval(() => {
                const now = Date.now();
                for (const [userId, lastSeen] of lastSeenByUser) {
                    if (now - lastSeen > staleLocationMilliseconds) {
                        removeUser(userId);
                    }
                }
            }, 15000);

            connection.onreconnecting(() => setStatus("Reconnecting…", "warning"));
            connection.onreconnected(() => setStatus(geolocationWatchId === null ? "Connected" : "Sharing location", "success"));
            connection.onclose(() => {
                shareButton.disabled = true;
                if (geolocationWatchId !== null && "geolocation" in navigator) {
                    navigator.geolocation.clearWatch(geolocationWatchId);
                    geolocationWatchId = null;
                    shareButton.textContent = "Share my location";
                }
                setStatus("Disconnected. Refresh to reconnect.", "danger");
            });

            connection.start()
                .then(() => {
                    shareButton.disabled = false;
                    setStatus("Connected", "success");
                })
                .catch(() => setStatus("Connection failed. Refresh to retry.", "danger"));

            function stopSharing(message = "Sharing stopped") {
                if (geolocationWatchId !== null) {
                    navigator.geolocation.clearWatch(geolocationWatchId);
                    geolocationWatchId = null;
                }
                shareButton.textContent = "Share my location";
                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("StopSharing").catch(() => {
                        if (myUserId !== null) {
                            removeUser(myUserId);
                        }
                    });
                } else if (myUserId !== null) {
                    removeUser(myUserId);
                }
                setStatus(message, "secondary");
            }

            function startSharing() {
                if (connection.state !== signalR.HubConnectionState.Connected) {
                    setStatus("Waiting for a secure connection…", "warning");
                    return;
                }
                if (!window.isSecureContext && window.location.hostname !== "localhost") {
                    setStatus("Secure HTTPS is required for location sharing", "danger");
                    return;
                }
                if (!("geolocation" in navigator)) {
                    setStatus("Location is not supported by this browser", "danger");
                    return;
                }

                setStatus("Waiting for location permission…", "info");
                geolocationWatchId = navigator.geolocation.watchPosition(position => {
                    const now = Date.now();
                    if (now - lastUpdateTime < updateIntervalMilliseconds) {
                        return;
                    }
                    lastUpdateTime = now;

                    const { latitude, longitude, accuracy } = position.coords;
                    if (connection.state !== signalR.HubConnectionState.Connected) {
                        setStatus("Location is ready; reconnecting…", "warning");
                        return;
                    }

                    connection.invoke("SendLocation", latitude, longitude, accuracy)
                        .then(() => setStatus("Sharing location", "success"))
                        .catch(() => setStatus("Could not send location. Reconnecting…", "warning"));

                    if (!firstLocationSent) {
                        map.setView([latitude, longitude], 15);
                    }
                }, error => {
                    const messages = {
                        [error.PERMISSION_DENIED]: "Location permission was denied",
                        [error.POSITION_UNAVAILABLE]: "Your location is unavailable",
                        [error.TIMEOUT]: "Location request timed out"
                    };
                    stopSharing(messages[error.code] || "Could not get your location");
                }, {
                    enableHighAccuracy: true,
                    maximumAge: 3000,
                    timeout: 15000
                });

                shareButton.textContent = "Stop sharing";
                setStatus("Waiting for your location…", "info");
            }

            shareButton.addEventListener("click", () => {
                if (geolocationWatchId === null) {
                    startSharing();
                } else {
                    stopSharing();
                }
            });

            centerButton.addEventListener("click", () => {
                const marker = myUserId === null ? null : markers.get(String(myUserId));
                if (marker) {
                    map.setView(marker.getLatLng(), 16);
                } else {
                    setStatus("Your location is not on the map yet", "info");
                }
            });

            window.addEventListener("pagehide", () => {
                if (geolocationWatchId !== null && "geolocation" in navigator) {
                    navigator.geolocation.clearWatch(geolocationWatchId);
                }
                connection.stop();
            }, { once: true });
        })();
    </script>
}

@{
    ViewData["Title"] = "Live Location Tracker";
    ViewData["FullWidth"] = true;
}

@section Styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
}

<div class="tracker-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <h1 class="h3 mb-0">Live Map</h1>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <span id="online-count" class="badge text-bg-light border" title="Team members seen in the last 10 minutes">0 online</span>
        <button id="center-me" type="button" class="btn btn-primary btn-sm" disabled>Center on Me</button>
        <div id="status" class="badge text-bg-secondary" role="status" aria-live="polite">Connecting…</div>
    </div>
</div>

<div id="map" role="application" aria-label="Real-time map of field team locations"></div>

<noscript>
    <div class="alert alert-warning mt-3">
        BMSL Tracker needs JavaScript and a location-capable browser to display live data.
    </div>
</noscript>

<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>

@section Scripts {
    <script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/js/tracker.js" asp-append-version="true"></script>
}

{
  // Production defaults. Secrets (connection strings, Google credentials) must come from the
  // environment or a secure configuration provider — never from this file.
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrations": true
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownNetworks": []
  },
  "Security": {
    "RequireHttps": true,
    "HstsMaxAgeDays": 365
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
